{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.zjdyzww/secret-triage",
  "description": "Triage a secret-scan report into real findings vs noise (tests, rules, docs, artifacts). Local-only.",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/zjdyzww/secret-triage:0.1.0",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "docker",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "run",
          "valueHint": "subcommand"
        },
        {
          "type": "positional",
          "value": "-i",
          "valueHint": "flag"
        },
        {
          "type": "positional",
          "value": "--rm",
          "valueHint": "flag"
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "triage_secret_report",
      "description": "Input a scanner report (gitleaks JSON / SARIF / text with path:line); output real-vs-excluded with per-item reasons.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "report": {
            "type": "string"
          },
          "fileContents": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "report"
        ]
      }
    }
  ]
}